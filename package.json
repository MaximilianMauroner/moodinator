{
  "name": "moodinator",
  "main": "index.js",
  "version": "1.5.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios",
    "web": "expo start --web",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "expo lint",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "doctor": "expo-doctor",
    "verify": "bun run lint && bun run typecheck && bun run test:run && bun run doctor && bun run verify:android-release-config",
    "verify:android-release-config": "node scripts/check-android-release-config.js",
    "build": "eas build --platform android --profile preview --local",
    "build:preview": "eas build --platform android --profile preview --local",
    "build:production": "eas build --platform android --profile production",
    "version:bump": "node scripts/bump-version.js",
    "qa:prepare": "node scripts/prepare-native-qa.js",
    "qa:smoke": "node scripts/run-native-smoke.js",
    "qa:fixtures": "node scripts/generate-qa-fixtures.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@shopify/flash-list": "2.0.2",
    "date-fns": "^4.1.0",
    "expo": "~55.0.31",
    "expo-application": "~55.0.19",
    "expo-background-task": "~55.0.22",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-local-authentication": "~55.0.18",
    "expo-localization": "~55.0.19",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-task-manager": "~55.0.20",
    "expo-web-browser": "~55.0.20",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-pager-view": "8.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "sonner": "^2.0.7",
    "sonner-native": "^0.25.0",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~55.0.1",
    "expo-doctor": "1.20.4",
    "react-test-renderer": "19.2.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.5"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "overrides": {
    "expo-image-loader": "55.0.1"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.13.1 <25",
    "bun": ">=1.3.14"
  }
}
